# StudyMate AI — Environment Configuration Example
# Copy this file to .env in your backend directory

# Gemma 4 Model Inference Configuration
# Supported providers: huggingface, groq, openrouter, ollama, demo_offline
GEMMA_PROVIDER=huggingface
GEMMA_MODEL_ID=google/gemma-4-it
GEMMA_API_URL=https://api-inference.huggingface.co/models/google/gemma-4-it
# Replace with your actual Gemma 4 inference provider API token
# Leave empty to run in Grounded Demo Mode (offline simulation)
GEMMA_API_KEY=your_gemma_api_key_here

# Application Settings
MAX_UPLOAD_SIZE_MB=15
CONFIDENCE_THRESHOLD=0.28
DATA_DIR=backend/data
PORT=8001
HOST=127.0.0.1
